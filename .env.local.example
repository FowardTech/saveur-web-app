# Copy this file to .env.local and fill in the values marked REQUIRED.
# .env.local is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Base URL for the Saveur backend (same backend the mobile app talks to).
# Defaults to https://api.saveurnow.com in lib/apiClient.ts if unset.
NEXT_PUBLIC_API_BASE_URL=https://api.saveurnow.com

# ---------------------------------------------------------------------------
# Firebase (project: saveur-ac8ec — same project as the mobile app)
# ---------------------------------------------------------------------------
# These four are project-wide and already correct — only override if the
# project's config ever changes.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=saveur-ac8ec.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=saveur-ac8ec
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=saveur-ac8ec.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=679326954548

# REQUIRED — these two are platform-specific and don't exist yet for Web.
# See README.md "Firebase setup" for how to get them (Firebase Console ->
# register a new "Web app" under the saveur-ac8ec project).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=

# REQUIRED for real browser push notifications (Settings > Security >
# "Enable browser push" — see lib/messaging.ts). Does NOT exist yet either.
# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push
# certificates -> "Generate key pair". Without this, the push feature UI
# shows "Push notifications aren't configured yet" and no-ops safely;
# everything else in the app is unaffected.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
