# Copy this to `.env` in this same directory ON THE DROPLET (not committed —
# real values are secrets/deployment-specific). docker-compose.yml reads
# this file both to substitute the build ARGs (see its own comment on why
# NEXT_PUBLIC_* must be real at build time) and as the running container's
# env_file.

# ---------------------------------------------------------------------------
# Backend API — the real droplet backend, same one the mobile app talks to.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.saveurnow.com

# This app's own public URL — used for metadata (Open Graph/Twitter cards,
# manifest) and as the default success/cancel base for Stripe Checkout
# redirects. Must match the domain actually pointed at this droplet.
NEXT_PUBLIC_SITE_URL=https://app.saveurnow.com

# ---------------------------------------------------------------------------
# Firebase (project: saveur-ac8ec — same project as mobile and local dev)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=saveur-ac8ec.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=saveur-ac8ec
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=saveur-ac8ec.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=679326954548
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCQ-hJKws1IHxBrKZ3V4Lk8Z0sbRvT7770
NEXT_PUBLIC_FIREBASE_APP_ID=1:679326954548:web:3acc7f6cf84baef1024661

# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push
# certificates key pair. This is the public half — safe to ship in client
# JS (that's the whole design of VAPID: this value is meant to be public).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BHjnmHvtNIsUU1ZRgxQ4lm87X0nYDq6HS8vtdUGV5YXfqVQW4HZ_eZKA--NDyV0sKW5r1NzLsQ23AWTDn5xvySU
